{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build C++ Backend",
            "type": "shell",
            "command": "g++",
            "args": [
                "-Wall",
                "-Wextra",
                "-std=c++17",
                "${workspaceFolder}/TravelOptimizerBackend.cpp",
                "-o",
                "${workspaceFolder}/TravelOptimizerBackend.exe"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": "$gcc"
        }
    ]
}
